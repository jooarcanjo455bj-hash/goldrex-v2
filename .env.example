# Copie este arquivo para ".env" (no computador e na VPS da Hostinger, dentro da pasta do projeto).
# Nada aqui é credencial real. NUNCA suba o arquivo ".env" para o GitHub.

# ---------- Supabase (Project Settings > API) ----------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
# Chave SECRETA (service_role). Só no servidor (.env da VPS). Nunca no navegador, nunca no GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Segurança ----------
# Texto aleatório com 32+ caracteres. Assina os links temporários de conteúdo. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Endereço do painel (padrão /admin). Troque por algo que só você saiba, ex.: /painel-x7k2
ADMIN_PATH=/admin

# ---------- Publicação ----------
# Endereço público do site (usado nos links dos e-mails de confirmação e recuperação de senha), ex.: https://seudominio.com.br
SITE_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
# "true" quando o site estiver em HTTPS (cookies Secure e HSTS)
HTTPS=false
# Na VPS (atrás do Nginx) use "true": usa o IP real do visitante nos bloqueios de tentativa
TRUST_PROXY=false
TRUSTED_PROXY_HOPS=1
# Na VPS use 127.0.0.1: o app só aceita conexões do Nginx. Vazio = aceita de qualquer lugar (uso local).
HOST=
# Limite de envio de foto/vídeo em MB (o plano gratuito do Supabase costuma aceitar até 50 MB por arquivo)
MAX_UPLOAD_MB=50


# ---------- Pix / Admin (versão atual) ----------
# Código de criação do 1º acesso admin. OBRIGATÓRIO em produção: sem ele, quem acessar /admin primeiro pode virar administrador.
ADMIN_SETUP_CODE=
PIX_KEY=
PIX_RECEIVER_NAME=
PIX_CITY=
PUSH_CONTACT=mailto:voce@seudominio.com.br
